{
  "name": "kanjialive-api",
  "version": "0.1.0",
  "description": "Kanji Alive App",
  "main": "dist/index.js",
  "author": "dayj",
  "dependencies": {
    "ejs": "^6.0.1",
    "express": "4.x",
    "mongodb": "6.x"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "tsc": "./node_modules/typescript/bin/tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint server",
    "test": "node --require ts-node/register --test 'server/**/*.test.ts'",
    "build": "tsc && npm run copyfiles",
    "dev": "ts-node server/index.ts",
    "copyfiles": "mkdir -p dist/static dist/partials dist/views && cp index.html dist/ && cp -R static/. dist/static/ && cp -R partials/. dist/partials/ && cp -R server/views/. dist/views/",
    "postinstall": "npm run build",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.3",
    "eslint": "^10.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0"
  }
}
