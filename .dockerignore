# This is NOT .gitignore. The two are entirely separate mechanisms, and the Dockerfile
# does `COPY . /opt/kanjialive` — so anything git deliberately excludes still lands in
# the image unless it is also listed here. The notes paths below were untracked AND
# scrubbed from git history; leaving them out of this file quietly undoes that.
.env
node_modules/
.idea/
.git/

# Local-only notes — see the "Local-only files" section of CLAUDE.md
CLAUDE.md
migration.md
offline/
plans/

# Build output. Without this a stale local dist/ is copied in and then only partially
# overwritten by postinstall, so files deleted from the source tree survive in the image.
dist/
