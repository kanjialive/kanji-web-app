node_modules/
# Covers JetBrains IDEs: IntelliJ, RubyMine, PhpStorm, AppCode, PyCharm, CLion, Android Studio and Webstorm
# Reference: https://intellij-support.jetbrains.com/hc/en-us/articles/206544839

# User-specific stuff:
.idea/workspace.xml
.idea/tasks.xml
.idea/dictionaries
.idea/vcs.xml
.idea/jsLibraryMappings.xml

# Sensitive or high-churn files:
.idea/dataSources.ids
.idea/dataSources.xml
.idea/dataSources.local.xml
.idea/sqlDataSources.xml
.idea/dynamic.xml
.idea/uiDesigner.xml

# Gradle:
.idea/gradle.xml
.idea/libraries

# Mongo Explorer plugin:
.idea/mongoSettings.xml

## File-based project format:
*.iws

## Plugin-specific files:

# IntelliJ
/out/

# mpeltonen/sbt-idea plugin
.idea_modules/

# JIRA plugin
atlassian-ide-plugin.xml

# Crashlytics plugin (for Android Studio and IntelliJ)
com_crashlytics_export_strings.xml
crashlytics.properties
crashlytics-build.properties
fabric.properties

# Secrets — never commit
.env

# Build output
dist/

# macOS
.DS_Store

# CLAUDE.md stays untracked (maintainer decision 2026-07-11): it is the
# assistant's working notes and must never reach the public github remote.
CLAUDE.md

# offline/ and plans/ untracked (maintainer decision 2026-07-11): internal
# analyses, session logs, and security reviews carrying file:line locations for
# unfixed issues. Previously tracked deliberately "so the roadmap survives
# outside a single machine"; that is now outweighed by the disclosure risk on
# the public github remote. NOTE: files already committed under offline/ and
# plans/ are still in the index and in history — ignoring them does not untrack
# or remove them. `git rm -r --cached` + a history scrub are separate steps.
offline/
plans/
