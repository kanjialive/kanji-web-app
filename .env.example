# MongoDB Atlas connection string (required — server exits if unset)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/kanjialive

# Shared secret for the public /api/public/* endpoints (required — server exits if unset)
# Sent by clients as the X-Mashape-Proxy-Secret request header
MASHAPE_SECRET=replace-with-a-long-random-string

# Port the server listens on (optional, defaults to 5000)
PORT=5000

# Set to "true" to serve the HTMX/Alpine frontend; unset/anything else serves legacy AngularJS
USE_HTMX=true
