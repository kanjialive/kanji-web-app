<%#
  Shown when a search fails for a reason that is NOT "zero matches" — e.g. the
  database is unreachable. Deliberately distinct from no-results.ejs: a silent
  "0 kanji found" during an outage is indistinguishable from a valid empty
  search, so nobody ever finds out the app is broken.
%>
<div class="scroller scroller-kanji">
  <div class="search-results search-results-kanji" style="width: 266px">
    <p class="no-results">
      <%= typeof error !== 'undefined' && error
          ? error
          : 'Sorry, something went wrong. Please try again in a moment.' %>
    </p>
  </div>
</div>
