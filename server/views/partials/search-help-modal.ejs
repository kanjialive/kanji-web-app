<div class="modal-content">
  <button class="modal-close" @click="$refs.helpDialog.close()" aria-label="Close">&times;</button>

  <h2>Quick Reference</h2>

  <h3>Quick Search</h3>
  <p>Enter any of the following directly into the search field:</p>
  <ul>
    <li>A kanji character</li>
    <li>Onyomi in katakana</li>
    <li>Kunyomi in hiragana</li>
    <li>English meaning</li>
  </ul>

  <h3>Advanced Search</h3>
  <p>Use prefixes to search specific fields:</p>
  <table class="help-table">
    <tr><td><code>on:</code></td><td>Onyomi (romaji)</td><td><code>on:shin</code></td></tr>
    <tr><td><code>kun:</code></td><td>Kunyomi (romaji)</td><td><code>kun:mizu</code></td></tr>
    <tr><td><code>ks:</code></td><td>Kanji strokes</td><td><code>ks:5</code></td></tr>
    <tr><td><code>rs:</code></td><td>Radical strokes</td><td><code>rs:3</code></td></tr>
    <tr><td><code>rad:</code></td><td>Radical name</td><td><code>rad:water</code></td></tr>
    <tr><td><code>grade:</code></td><td>School grade</td><td><code>grade:2</code></td></tr>
    <tr><td><code>ap:</code></td><td>AP Japanese</td><td><code>ap:*</code></td></tr>
    <tr><td><code>jlpt:</code></td><td>JLPT level</td><td><code>jlpt:N3</code></td></tr>
  </table>

  <h3>Keyboard Shortcuts</h3>
  <table class="help-table">
    <tr><td><kbd>&uarr;</kbd> / <kbd>&darr;</kbd></td><td>Cycle sort modes</td></tr>
    <tr><td><kbd>&larr;</kbd> / <kbd>&rarr;</kbd></td><td>Scroll results</td></tr>
  </table>

  <p class="help-footer">
    <a href="https://kanjialive.com/user-guide" target="_blank" rel="noopener">Full User Guide</a>
  </p>
</div>
