<%
const currentMode = typeof mode !== 'undefined' ? mode : 'kanji';
const origQueryString = typeof queryString !== 'undefined' ? queryString : '';

// Detail URL: just kanji + search params (server computes neighbors from search results)
function buildDetailUrl(kanjiChar) {
  return `/${encodeURIComponent(kanjiChar)}${origQueryString}`;
}
%>

<% if (currentMode === 'kanji') { %>
  <!-- Simple Kanji Grid -->
  <%
  // Legacy fill order: constrain the paragraph width so kanji wrap into at
  // most 12 rows — results fill top-to-bottom, then extend rightward into
  // the horizontal scroll (search-controller.js kanjiResultsStyle)
  const kanjiGridWidth = Math.max(Math.ceil(results.length / 12), 7) * 38;
  %>
  <div class="scroller scroller-kanji">
    <div class="search-results search-results-kanji" style="width: <%= kanjiGridWidth %>px">
      <div id="kanji-count" class="ka-results-h1"><%= results.length %></div>
      <div class="ka-results-h3">Kanji</div>
      <div class="ka-border-bottom">
        <div class="border-inner"></div>
      </div>
      <%# lang="ja" — see detail.ejs. Bare kanji are the MOST exposed text in the app: with
          the page marked lang="en", any browser that reaches the generic font renders them
          in a Chinese face (macOS hands back PingFang SC — a 0.00% pixel match), so 直/骨/
          画/角 would show the wrong strokes in the very grid students click to learn them. %>
      <%# ⚠️ NO trailing space after the kanji, and none between the anchors either —
          the gap is CSS now (p.kanji > a.ka { padding-right }). It used to be this
          literal space character, which made the grid's column pitch a FONT METRIC:
          the retired mplus-1m-light was monospaced (space = 0.5em = 12.5px), so the
          pitch was 37.5px and the 38px-per-column width above was sized to it. Any
          substitute face has a narrower space (Hiragino: 0.333em = 8.32px) and the
          grid silently reflows — 8 kanji per row instead of 7. p.kanji's font-size:0
          collapses the whitespace between these tags, so re-indenting this loop is
          safe; adding a space back inside the anchor is not. %>
      <p class="kanji" lang="ja" style="width: <%= kanjiGridWidth %>px">
        <% results.forEach((kanji, index) => { %>
          <a href="<%= buildDetailUrl(kanji.ka_utf) %>"
             id="<%= kanji.ka_id %>"
             class="ka"><%= kanji.ka_utf %></a>
        <% }); %>
      </p>
    </div>
  </div>

<% } else if (currentMode === 'ksort' && typeof kanjiStrokeGroups !== 'undefined') { %>
  <!-- Kanji Stroke Groups -->
  <div class="scroller row search-results-container">
    <div class="search-results">
      <ul class="list-inline">
        <% kanjiStrokeGroups.forEach(group => { %>
          <li class="results-group">
            <%# numberOrBlank — a stroke count is a raw Mongo number and NaN is a real
                sentinel in this data. No kanji holds kstroke: NaN today; the radical
                branch below does, and these two headings must not drift apart. %>
            <div class="ka-results-h1"><%= numberOrBlank(group.stroke) %></div>
            <div class="ka-results-h3">Kanji Stroke<%= group.stroke !== 1 ? 's' : '' %></div>
            <div class="ka-border-bottom">
              <div class="border-inner"></div>
            </div>
            <div class="grouped-results">
              <% group.columns.forEach(column => { %>
                <div class="grouped-column inline">
                  <% column.forEach(radical => { %>
                    <div>
                      <div class="ka-radical inline" lang="ja"><%= radical.radical %></div>
                      <div class="grouped-row-container inline" lang="ja">
                        <% radical.rows.forEach(row => { %>
                          <div class="grouped-row">
                            <% row.forEach(kanji => { %>
                              <a href="<%= buildDetailUrl(kanji.ka_utf) %>"
                                 id="<%= kanji.ka_id %>"
                                 class="ka"><%= kanji.ka_utf %></a>
                            <% }); %>
                          </div>
                        <% }); %>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% }); %>
            </div>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>

<% } else if (currentMode === 'rsort' && typeof radicalStrokeGroups !== 'undefined') { %>
  <!-- Radical Stroke Groups -->
  <div class="scroller row search-results-container">
    <div class="search-results">
      <ul class="list-inline">
        <% radicalStrokeGroups.forEach(group => { %>
          <li class="results-group">
            <%# 🔴 numberOrBlank is load-bearing HERE. 々 holds rad_stroke: NaN meaning
                "no radical strokes", so this printed a results heading reading literally
                "NaN" — reachable at /search?rs=n/a&mode=rsort. Production renders it
                blank (its NaN becomes null crossing JSON to Angular); so must this.
                The label below deliberately still says "Strokes": NaN !== 1, exactly as
                production's null !== 1. %>
            <div class="ka-results-h1"><%= numberOrBlank(group.stroke) %></div>
            <div class="ka-results-h3">Radical Stroke<%= group.stroke !== 1 ? 's' : '' %></div>
            <div class="ka-border-bottom">
              <div class="border-inner"></div>
            </div>
            <div class="grouped-results">
              <% group.columns.forEach(column => { %>
                <div class="grouped-column inline">
                  <% column.forEach(radical => { %>
                    <div>
                      <div class="ka-radical inline" lang="ja"><%= radical.radical %></div>
                      <div class="grouped-row-container inline" lang="ja">
                        <% radical.rows.forEach(row => { %>
                          <div class="grouped-row">
                            <% row.forEach(kanji => { %>
                              <a href="<%= buildDetailUrl(kanji.ka_utf) %>"
                                 id="<%= kanji.ka_id %>"
                                 class="ka"><%= kanji.ka_utf %></a>
                            <% }); %>
                          </div>
                        <% }); %>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% }); %>
            </div>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>

<% } else { %>
  <%- include('./no-results') %>
<% } %>
