<%
const currentMode = typeof mode !== 'undefined' ? mode : 'kanji';
const origQueryString = typeof queryString !== 'undefined' ? queryString : '';

// Kanji + search params; the server computes neighbours from the search results.
function buildDetailUrl(kanjiChar) {
  return `/${encodeURIComponent(kanjiChar)}${origQueryString}`;
}
%>

<% if (currentMode === 'kanji') { %>
  <%# Simple kanji grid %>
  <%
  // Constrains the paragraph width so kanji wrap into at most 12 rows: results fill
  // top-to-bottom, then extend rightward into the horizontal scroll.
  const kanjiGridWidth = Math.max(Math.ceil(results.length / 12), 7) * 38;
  %>
  <div class="scroller scroller-kanji">
    <div class="search-results search-results-kanji" style="width: <%= kanjiGridWidth %>px">
      <div id="kanji-count" class="ka-results-h1" aria-hidden="true"><%= results.length %></div>
      <div class="ka-results-h3" role="heading" aria-level="2"
           aria-label="<%= results.length %> kanji">Kanji</div>
      <div class="ka-border-bottom">
        <div class="border-inner"></div>
      </div>
      <%# lang="ja" — see detail.ejs. Bare kanji are the most exposed text in the app: on
          a lang="en" page any browser reaching the generic font draws them in a Chinese
          face, so 直/骨/画/角 would show the wrong strokes in the very grid students
          click to learn them. %>
      <%# NO space after the kanji, and none between the anchors: the gap is CSS now
          (p.kanji > a.ka { padding-right }). As a literal space it was a FONT METRIC —
          a face with a narrower space silently reflowed the grid to 8 kanji per row
          where 7 belong, breaking the 38px-per-column width above. font-size:0 collapses
          the whitespace between these tags, so re-indenting the loop is safe; putting a
          space back inside the anchor is not. %>
      <p class="kanji" lang="ja" style="width: <%= kanjiGridWidth %>px">
        <% results.forEach((kanji, index) => { %>
          <a href="<%= buildDetailUrl(kanji.ka_utf) %>"
             id="<%= kanji.ka_id %>"
             class="ka"><%= kanji.ka_utf %></a>
        <% }); %>
      </p>
    </div>
  </div>

<% } else if (currentMode === 'ksort' && typeof kanjiStrokeGroups !== 'undefined') { %>
  <%# Kanji stroke groups %>
  <div class="scroller row search-results-container">
    <div class="search-results">
      <ul class="list-inline">
        <% kanjiStrokeGroups.forEach(group => { %>
          <li class="results-group">
            <%# numberOrBlank: a stroke count is a raw Mongo number and NaN is a real
                sentinel here. No kanji holds kstroke: NaN today, but the radical branch
                below does and these two headings must not drift apart. %>
            <div class="ka-results-h1" aria-hidden="true"><%= numberOrBlank(group.stroke) %></div>
            <div class="ka-results-h3" role="heading" aria-level="2"
                 aria-label="<%= (numberOrBlank(group.stroke) + ' kanji stroke' + (group.stroke !== 1 ? 's' : '')).trim() %>">Kanji Stroke<%= group.stroke !== 1 ? 's' : '' %></div>
            <div class="ka-border-bottom">
              <div class="border-inner"></div>
            </div>
            <div class="grouped-results">
              <% group.columns.forEach(column => { %>
                <div class="grouped-column inline">
                  <% column.forEach(radical => { %>
                    <div>
                      <%# Japanese name ONLY — never the meaning (the app withholds easy
                          answers) and no romaji (VoiceOver re-read it in English). REAL
                          hidden text, not an aria-label: NVDA speaks attributes in the
                          page language, so a label never reaches the Japanese voice.
                          The glyph stays aria-hidden — VoiceOver appends its own
                          English description. %>
                      <% if (radical.rad_name_ja && radical.rad_name && radical.rad_name !== "n/a") { %>
                      <div class="ka-radical inline" lang="ja"><span class="visually-hidden"><%= radical.rad_name_ja %></span><span aria-hidden="true"><%= radical.radical %></span></div>
                      <% } else { %>
                      <div class="ka-radical inline" lang="ja"><%= radical.radical %></div>
                      <% } %>
                      <div class="grouped-row-container inline" lang="ja">
                        <% radical.rows.forEach(row => { %>
                          <div class="grouped-row">
                            <% row.forEach(kanji => { %>
                              <a href="<%= buildDetailUrl(kanji.ka_utf) %>"
                                 id="<%= kanji.ka_id %>"
                                 class="ka"><%= kanji.ka_utf %></a>
                            <% }); %>
                          </div>
                        <% }); %>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% }); %>
            </div>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>

<% } else if (currentMode === 'rsort' && typeof radicalStrokeGroups !== 'undefined') { %>
  <%# Radical stroke groups %>
  <div class="scroller row search-results-container">
    <div class="search-results">
      <ul class="list-inline">
        <% radicalStrokeGroups.forEach(group => { %>
          <li class="results-group">
            <%# numberOrBlank is load-bearing HERE: 々 holds rad_stroke: NaN, so without
                it this heading prints the literal string "NaN" (reachable at
                /search?rs=&mode=rsort). Renders blank, like production. The label below
                deliberately still says "Strokes" — NaN !== 1. %>
            <div class="ka-results-h1" aria-hidden="true"><%= numberOrBlank(group.stroke) %></div>
            <div class="ka-results-h3" role="heading" aria-level="2"
                 aria-label="<%= (numberOrBlank(group.stroke) + ' radical stroke' + (group.stroke !== 1 ? 's' : '')).trim() %>">Radical Stroke<%= group.stroke !== 1 ? 's' : '' %></div>
            <div class="ka-border-bottom">
              <div class="border-inner"></div>
            </div>
            <div class="grouped-results">
              <% group.columns.forEach(column => { %>
                <div class="grouped-column inline">
                  <% column.forEach(radical => { %>
                    <div>
                      <%# Japanese name as hidden text, glyph aria-hidden — see the ksort branch. %>
                      <% if (radical.rad_name_ja && radical.rad_name && radical.rad_name !== "n/a") { %>
                      <div class="ka-radical inline" lang="ja"><span class="visually-hidden"><%= radical.rad_name_ja %></span><span aria-hidden="true"><%= radical.radical %></span></div>
                      <% } else { %>
                      <div class="ka-radical inline" lang="ja"><%= radical.radical %></div>
                      <% } %>
                      <div class="grouped-row-container inline" lang="ja">
                        <% radical.rows.forEach(row => { %>
                          <div class="grouped-row">
                            <% row.forEach(kanji => { %>
                              <a href="<%= buildDetailUrl(kanji.ka_utf) %>"
                                 id="<%= kanji.ka_id %>"
                                 class="ka"><%= kanji.ka_utf %></a>
                            <% }); %>
                          </div>
                        <% }); %>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% }); %>
            </div>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>

<% } else { %>
  <%- include('./no-results') %>
<% } %>
