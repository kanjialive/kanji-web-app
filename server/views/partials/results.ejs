<%
const currentMode = typeof mode !== 'undefined' ? mode : 'kanji';
const searchQuery = typeof query !== 'undefined' ? query : '';
const origQueryString = typeof queryString !== 'undefined' ? queryString : '';
const order = typeof resultsOrder !== 'undefined' ? resultsOrder : [];

// Helper to build detail URL with navigation context
// Preserves original search params (including advanced search) for back-navigation
function buildDetailUrl(kanjiChar, index) {
  const prev = index > 0 ? order[index - 1] : '';
  const next = index < order.length - 1 ? order[index + 1] : '';

  // Start with base URL
  let url = `/htmx/${encodeURIComponent(kanjiChar)}?idx=${index}&total=${order.length}`;

  // Add original query params (preserves advanced search params)
  if (origQueryString) {
    // Remove leading ? and append params
    const params = origQueryString.replace(/^\?/, '');
    if (params) url += `&${params}`;
  } else if (searchQuery) {
    // Fallback to basic query
    url += `&q=${encodeURIComponent(searchQuery)}&mode=${currentMode}`;
  }

  // Add navigation params
  if (prev) url += `&prev=${encodeURIComponent(prev)}`;
  if (next) url += `&next=${encodeURIComponent(next)}`;
  return url;
}
%>

<% if (currentMode === 'kanji') { %>
  <!-- Simple Kanji Grid -->
  <div class="scroller scroller-kanji">
    <div class="search-results search-results-kanji">
      <div id="kanji-count" class="ka-results-h1"><%= results.length %></div>
      <div class="ka-results-h3">Kanji</div>
      <div class="ka-border-bottom">
        <div class="border-inner"></div>
      </div>
      <p class="kanji">
        <% results.forEach((kanji, index) => { %>
          <a href="<%= buildDetailUrl(kanji.ka_utf, index) %>"
             id="<%= kanji.ka_id %>"
             class="ka"
             data-index="<%= index %>"><%= kanji.ka_utf %> </a>
        <% }); %>
      </p>
    </div>
  </div>

<% } else if (currentMode === 'ksort' && typeof kanjiStrokeGroups !== 'undefined') { %>
  <!-- Kanji Stroke Groups -->
  <%
  // Build index map for grouped display order
  let ksortIndex = 0;
  %>
  <div class="scroller row search-results-container">
    <div class="search-results">
      <ul class="list-inline">
        <% kanjiStrokeGroups.forEach(group => { %>
          <li class="results-group">
            <div class="ka-results-h1"><%= group.stroke %></div>
            <div class="ka-results-h3">Kanji Stroke<%= group.stroke !== 1 ? 's' : '' %></div>
            <div class="ka-border-bottom">
              <div class="border-inner"></div>
            </div>
            <div class="grouped-results">
              <% group.columns.forEach(column => { %>
                <div class="grouped-column inline">
                  <% column.forEach(radical => { %>
                    <div>
                      <div class="ka-radical inline"><%= radical.radical %></div>
                      <div class="grouped-row-container inline">
                        <% radical.rows.forEach(row => { %>
                          <div class="grouped-row">
                            <% row.forEach(kanji => { %>
                              <a href="<%= buildDetailUrl(kanji.ka_utf, ksortIndex++) %>"
                                 id="<%= kanji.ka_id %>"
                                 class="ka"
                                 data-index="<%= kanji.sortedIndex %>"><%= kanji.ka_utf %></a>
                            <% }); %>
                          </div>
                        <% }); %>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% }); %>
            </div>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>

<% } else if (currentMode === 'rsort' && typeof radicalStrokeGroups !== 'undefined') { %>
  <!-- Radical Stroke Groups -->
  <%
  // Build index map for grouped display order
  let rsortIndex = 0;
  %>
  <div class="scroller row search-results-container">
    <div class="search-results">
      <ul class="list-inline">
        <% radicalStrokeGroups.forEach(group => { %>
          <li class="results-group">
            <div class="ka-results-h1"><%= group.stroke %></div>
            <div class="ka-results-h3">Radical Stroke<%= group.stroke !== 1 ? 's' : '' %></div>
            <div class="ka-border-bottom">
              <div class="border-inner"></div>
            </div>
            <div class="grouped-results">
              <% group.columns.forEach(column => { %>
                <div class="grouped-column inline">
                  <% column.forEach(radical => { %>
                    <div>
                      <div class="ka-radical inline"><%= radical.radical %></div>
                      <div class="grouped-row-container inline">
                        <% radical.rows.forEach(row => { %>
                          <div class="grouped-row">
                            <% row.forEach(kanji => { %>
                              <a href="<%= buildDetailUrl(kanji.ka_utf, rsortIndex++) %>"
                                 id="<%= kanji.ka_id %>"
                                 class="ka"
                                 data-index="<%= kanji.sortedIndex %>"><%= kanji.ka_utf %></a>
                            <% }); %>
                          </div>
                        <% }); %>
                      </div>
                    </div>
                  <% }); %>
                </div>
              <% }); %>
            </div>
          </li>
        <% }); %>
      </ul>
    </div>
  </div>

<% } else { %>
  <%- include('./no-results') %>
<% } %>
