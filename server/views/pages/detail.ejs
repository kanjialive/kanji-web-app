<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= doc.ka_utf %> - <%= doc.meaning %>. Learn to read and write this kanji with Kanji alive."/>
  <title><%= doc.ka_utf %> - <%= doc.meaning %> - Kanji alive</title>

  <!-- CSS -->
  <link href="/static/css/kanji-alive-modern.css" rel="stylesheet">

  <!-- Alpine.js — served from this app, NOT a CDN. A vendored, pinned copy cannot
       become un-fetchable if a package registry disappears, and browsers do not
       break backwards compatibility, so it keeps working regardless of upstream. -->
  <script src="/static/js/libs/alpinejs-3.15.12.min.js" defer></script>

  <%- include('../partials/focus-ring') %>

  <!-- Alpine component + page navigation (runs once, survives content swaps) -->
  <script>
  // Register the detail page component once, before Alpine starts
  document.addEventListener('alpine:init', function() {
    Alpine.data('detailPage', () => ({
      detailMode: 'video',
      playing: false,
      typeface: 'kyokasho',
      typefaceIndex: 4,
      typefaces: ['suzumushi', 'kanteiryu', 'hiragino', 'tensho', 'kyokasho', 'mincho', 'gothic', 'maru'],
      typefaceDisplayNames: {
        'suzumushi': 'Suzumushi',
        'kanteiryu': 'Kanteiryu',
        'hiragino': 'Gyosho',
        'tensho': 'Tensho',
        'kyokasho': 'Kyokashotai',
        'mincho': 'Mincho',
        'gothic': 'Gothic',
        'maru': 'Maru'
      },
      radicalFrame: 0,
      radicalAnimating: false,
      // Radical animation timing. The cross-fade duration lives in CSS
      // (.ka-rad-anim img, currently 1.375s) and is subtracted from the gap, so
      // an image is fully still for (gap - fade) = 250ms. Keep them in step.
      radicalFirstPause: 500,   // click -> frame 1
      radicalFrameGap: 1625,    // frame -> frame (1.375s fade + 250ms still)
      stroketimes: [],

      get typefaceDisplay() {
        return this.typefaceDisplayNames[this.typeface] || this.typeface;
      },

      togglePlayPause() {
        const video = this.$refs.video;
        if (video.paused) {
          video.play();
          this.playing = true;
        } else {
          video.pause();
          this.playing = false;
        }
      },

      stepForward() {
        const video = this.$refs.video;
        const currentTime = video.currentTime;
        for (let i = 0; i < this.stroketimes.length; i++) {
          if (this.stroketimes[i] > currentTime + 0.01) {
            this.seek(this.stroketimes[i]);
            return;
          }
        }
        this.seek(video.duration);
      },

      stepBackward() {
        const video = this.$refs.video;
        const currentTime = video.currentTime;
        for (let i = this.stroketimes.length - 1; i >= 0; i--) {
          if (this.stroketimes[i] < currentTime - 0.01) {
            this.seek(this.stroketimes[i]);
            return;
          }
        }
      },

      seek(time) {
        const video = this.$refs.video;
        video.pause();
        this.playing = false;
        video.currentTime = time;
      },

      nextTypeface() {
        this.typefaceIndex = Math.min(this.typefaceIndex + 1, this.typefaces.length - 1);
        this.typeface = this.typefaces[this.typefaceIndex];
      },

      previousTypeface() {
        this.typefaceIndex = Math.max(this.typefaceIndex - 1, 0);
        this.typeface = this.typefaces[this.typefaceIndex];
      },

      startRadicalAnimation() {
        // Three deliberate departures from Angular (detail-controller.js:198),
        // all chosen by the maintainer 2026-07-12. Recorded here so a future
        // parity sweep does not "correct" them back to production's values.
        //
        //  1. radicalFirstPause is 500ms, not Angular's 1250ms — the animation
        //     used to sit motionless for over a second after the click.
        //  2. radicalFrameGap is 1625ms, not 1250ms. The CSS opacity fade on
        //     .ka-rad-anim img (1.375s, vs production's 1s) is subtracted from
        //     this gap, so an image is FULLY STILL for (gap - fade) = 250ms.
        //     The fade IS the animation — one radical dissolving into the next —
        //     so it takes most of the frame, and the still period is a breath
        //     between transitions rather than a slideshow.
        //  3. Re-entrancy is guarded. Angular has none: clicking mid-animation
        //     schedules an overlapping pass and the frames fight each other.
        //
        // Frames land at 500 / 2125 / 3750ms.
        //
        // The JS timings live on the component (not as consts) so they can be
        // tuned live in the browser console without a rebuild — but the fade is
        // CSS, so change BOTH or the still period drifts:
        //   var d = document.querySelector('.container2')._x_dataStack[0];
        //   d.radicalFrameGap = 1625;
        //   document.querySelectorAll('.ka-rad-anim img')
        //     .forEach(i => i.style.transitionDuration = '1.375s');
        //   document.querySelector('.ka-rad-anim').click();
        if (this.radicalAnimating) return;
        this.radicalAnimating = true;

        const first = this.radicalFirstPause;
        const gap = this.radicalFrameGap;

        setTimeout(() => { this.radicalFrame = 1; }, first);
        setTimeout(() => { this.radicalFrame = 2; }, first + gap);
        setTimeout(() => {
          this.radicalFrame = 0;
          this.radicalAnimating = false;
        }, first + gap * 2);
      },

      init() {
        this.stroketimes = JSON.parse(this.$el.dataset.stroketimes || '[]');

        // Persist the view mode and chosen typeface across kanji navigation.
        // Prev/next paging replaces .container2 with a freshly-initialised
        // component (see navigateKanji), so without this the mode would reset
        // to 'video' every time you stepped left/right — you'd flip to a new
        // kanji only to be dropped back into the animation. Production keeps
        // these on the singleton searchService (detail-controller.js); the
        // window store is the equivalent that survives a content swap.
        const saved = window._detailViewState;
        if (saved) {
          this.detailMode = saved.detailMode;
          this.typeface = saved.typeface;
          this.typefaceIndex = saved.typefaceIndex;
        }
        const persist = () => {
          window._detailViewState = {
            detailMode: this.detailMode,
            typeface: this.typeface,
            typefaceIndex: this.typefaceIndex,
          };
        };
        this.$watch('detailMode', persist);
        this.$watch('typeface', persist);

        if (window._detailKeydownHandler) {
          document.removeEventListener('keydown', window._detailKeydownHandler);
        }

        this.$refs.video?.addEventListener('ended', () => {
          this.playing = false;
        });

        const handler = (e) => {
          if (e.target.tagName === 'INPUT') return;

          // 'r' — replay the radical animation. The only feature with no key of
          // its own; the radical image was mouse-only in both frontends.
          //
          // Matched on e.key, NOT e.code like the cases below. e.code is the
          // physical key position, so 'KeyR' fires for whatever sits where R is
          // on QWERTY — on Dvorak that is the key that types 'o'. A mnemonic
          // shortcut has to follow the character the user actually typed.
          //
          // Modifiers are excluded so Cmd+R / Ctrl+R (reload) is never hijacked.
          // No preventDefault: a bare 'r' has no default action to suppress, and
          // startRadicalAnimation() already guards against re-entry.
          if (e.key && e.key.toLowerCase() === 'r' && !e.metaKey && !e.ctrlKey && !e.altKey) {
            this.startRadicalAnimation();
            return;
          }

          switch(e.code) {
            case 'Space':
              e.preventDefault();
              this.togglePlayPause();
              break;
            case 'ArrowUp':
            case 'ArrowDown':
              e.preventDefault();
              this.detailMode = this.detailMode === 'video' ? 'typeface' : 'video';
              break;
            case 'ArrowLeft':
              if (e.shiftKey) {
                if (this.detailMode === 'typeface') {
                  this.previousTypeface();
                } else {
                  this.stepBackward();
                }
              } else {
                const prevLink = document.querySelector('.recordCounter a.icon-left');
                if (prevLink) prevLink.click();
              }
              break;
            case 'ArrowRight':
              if (e.shiftKey) {
                if (this.detailMode === 'typeface') {
                  this.nextTypeface();
                } else {
                  this.stepForward();
                }
              } else {
                const nextLink = document.querySelector('.recordCounter a.icon-right');
                if (nextLink) nextLink.click();
              }
              break;
          }
        };
        window._detailKeydownHandler = handler;
        document.addEventListener('keydown', handler);
      },

      destroy() {
        if (window._detailKeydownHandler) {
          document.removeEventListener('keydown', window._detailKeydownHandler);
          window._detailKeydownHandler = null;
        }
      }
    }));
  });

  // Smooth prev/next navigation via fetch + DOM swap. Alpine's MutationObserver
  // initialises the replaced subtree on its own — do not reintroduce a swap
  // library here, its settling pipeline races the observer (see CLAUDE.md).
  window.navigateKanji = async function(url, e) {
    e.preventDefault();
    try {
      var r = await fetch(url);
      var html = await r.text();
      var doc = new DOMParser().parseFromString(html, 'text/html');
      var nc = doc.querySelector('.container2');
      if (!nc) throw new Error('missing container');
      document.querySelector('.container2').replaceWith(nc);
      history.pushState(null, '', url.replace(/\?.*$/, ''));
      if (nc.dataset.title) document.title = nc.dataset.title;
    } catch(err) {
      window.location.href = url;
    }
  };

  // Handle browser back/forward after pushState navigation
  window.addEventListener('popstate', function() {
    window.location.reload();
  });

  // Example audio playback (in head so it survives content swaps)
  window.playExampleAudio = function(src) {
    var audio = document.getElementById('example-audio');
    if (audio) { audio.src = src; audio.play(); }
  };
  </script>

  <base href="/">
</head>
<body>

<div class="container">
<div class="container2" x-data="detailPage()" data-stroketimes='<%= JSON.stringify(doc.stroketimes) %>' data-title="<%= doc.ka_utf %> - <%= doc.meaning %> - Kanji alive">

  <%
  // Navigation context (computed server-side from search results)
  const idx = typeof currentIndex !== 'undefined' ? currentIndex : 0;
  const total = typeof totalResults !== 'undefined' ? totalResults : 1;
  const prev = typeof prevKanji !== 'undefined' ? prevKanji : null;
  const next = typeof nextKanji !== 'undefined' ? nextKanji : null;
  const qs = typeof queryString !== 'undefined' ? queryString : '';

  // Build nav URLs — just kanji + search params (server computes neighbors)
  const prevUrl = prev
    ? `/${encodeURIComponent(prev)}${qs}`
    : '';
  const nextUrl = next
    ? `/${encodeURIComponent(next)}${qs}`
    : '';
  %>

  <!-- Column 1: Search Form + Video/Typeface -->
  <div class="col1">
    <div class="row1">
      <form class="search-form" action="/search" method="get">
        <input type="text"
               name="q"
               id="search-input"
               class="search-bar"
               value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
               spellcheck="false"
               autocapitalize="off"
               autocorrect="off">
        <button type="submit" class="search-button" aria-label="Search"></button>
      </form>
    </div>
    <div class="row2">
      <h3 id="kanji">Kanji</h3>

      <div class="container-typeface-video">
        <!-- Video Mode -->
        <div class="video-container" x-show="detailMode === 'video'">
          <div class="video">
            <%_ /* margin-left is normally 6px from CSS (the 2013 nudge). For the 60 stroke
                    stills whose ink the maintainer approved a correction for, it becomes
                    6 + dx and is written inline. Every other kanji emits no style at all.
                    NOT a transform — that would composite the video and risk the Safari
                    overlay hairline that clip-path:inset(0) exists to suppress. */ _%>
            <video x-ref="video"
                   @click="detailMode = 'typeface'"
                   poster="<%= doc.poster_video_source %>"
                   <%_ if (videoMarginLeft !== 6) { _%>
                   style="margin-left: <%= videoMarginLeft %>px"
                   <%_ } _%>
                   playsinline
                   preload="metadata">
              <source src="<%= doc.mp4_video_source %>" type="video/mp4">
              <source src="<%= doc.webm_video_source %>" type="video/webm">
            </video>
          </div>
          <div class="animation-controls">
            <button class="icon-step-left ka-icon-gray pointer"
                    @click="stepBackward()"
                    aria-label="Step backward"></button>
            <button :class="playing ? 'icon-pause' : 'icon-play'"
                    class="ka-icon-gray pointer"
                    @click="togglePlayPause()"
                    aria-label="Play/Pause"></button>
            <button class="icon-step-right ka-icon-gray pointer"
                    @click="stepForward()"
                    aria-label="Step forward"></button>
          </div>
        </div>

        <!-- Typeface Mode -->
        <div id="ka-typeface-container" x-show="detailMode === 'typeface'" x-cloak>
          <div @click="detailMode = 'video'" class="ka-typefaces">
            <img x-show="typeface === 'tensho'" src="<%= doc.tensho_source %>" alt="Tensho typeface">
            <img x-show="typeface === 'kyokasho'" src="<%= doc.kyokasho_source %>" alt="Kyokasho typeface">
            <img x-show="typeface === 'maru'" src="<%= doc.maru_source %>" alt="Maru typeface">
            <img x-show="typeface === 'mincho'" src="<%= doc.mincho_source %>" alt="Mincho typeface">
            <img x-show="typeface === 'gothic'" src="<%= doc.gothic_source %>" alt="Gothic typeface">
            <img x-show="typeface === 'hiragino'" src="<%= doc.hiragino_source %>" alt="Hiragino typeface">
            <img x-show="typeface === 'kanteiryu'" src="<%= doc.kanteiryu_source %>" alt="Kanteiryu typeface">
            <img x-show="typeface === 'suzumushi'" src="<%= doc.suzumushi_source %>" alt="Suzumushi typeface">
          </div>
          <div class="animation-controls">
            <button @click="previousTypeface()" class="ka-typeface-left pointer">&#12296;</button>
            <span class="typeface-name" x-html="typefaceDisplay"></span>
            <button @click="nextTypeface()" class="ka-typeface-right pointer">&#12297;</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Column 2: Navigation + Meaning, Readings, Radical -->
  <div class="col2">
    <div class="row1">
      <div class="recordCounter">
        <% if (prev) { %>
          <a class="icon icon-left" href="<%= prevUrl %>" onclick="navigateKanji(this.href, event)">&#12296;</a>
        <% } else { %>
          <span class="icon icon-left disabled">&#12296;</span>
        <% } %>
        <span class="search">
          <% if (typeof lastSearch !== 'undefined' && lastSearch) { %>
            <a href="<%= lastSearch %>"><%= idx + 1 %> of <%= total %></a>
          <% } else { %>
            <%# production always renders the counter as a link (falls back to a
                single-kanji search) — the .row1 a rule gives it 17px rust %>
            <a href="/search?q=<%= encodeURIComponent(doc.ka_utf) %>">1 of 1</a>
          <% } %>
        </span>
        <% if (next) { %>
          <a class="icon icon-right" href="<%= nextUrl %>" onclick="navigateKanji(this.href, event)">&#12297;</a>
        <% } else { %>
          <span class="icon icon-right disabled">&#12297;</span>
        <% } %>
      </div>
    </div>
    <div class="row2">
      <h3 class="meaning">Meaning</h3>
      <p class="meaning"><%= doc.meaning %></p>

      <h3 class="onyomi">Onyomi</h3>
      <%# lang="ja" is load-bearing, not decoration. The page is lang="en"; when font
          fallback reaches the generic, the browser picks the CJK face by DOCUMENT
          language — and macOS then hands back PingFang SC, i.e. CHINESE glyph forms
          (verified: a 0.00% pixel match against PingFang SC). 骨 直 画 角 are drawn
          differently in Chinese, and this app teaches the Japanese strokes. Marking the
          text as Japanese makes even the generic resolve to Hiragino Sans. %>
      <p class="onyomi" lang="ja"><%= doc.onyomi_ja %></p>

      <h3 class="kunyomi">Kunyomi</h3>
      <p class="kunyomi" lang="ja"><%= doc.kunyomi_ka_display %></p>

      <div class="border3"><div class="border-inner"></div></div>

      <h3 class="radical">Radical</h3>
      <img class="radical-character" src="<%= doc.rad_char_source %>" alt="Radical character">
      <% if (doc.rad_position && doc.rad_position_file) { %>
        <img class="radical-position" src="<%= doc.rad_position_file %>" alt="Radical position">
      <% } %>
      <div class="radical-name" lang="ja"><%= doc.rad_name_ja %></div>
      <div class="radical-meaning"><%= doc.rad_meaning %></div>
      <div class="radical-stroke"><%= doc.rad_stroke %></div>

      <div class="ka-rad-anim pointer" @click="startRadicalAnimation()">
        <img :class="{'opaque': radicalFrame === 0}" src="<%= doc.rad_anim_frame_0 %>" alt="Radical animation frame 1">
        <img :class="{'opaque': radicalFrame === 1}" src="<%= doc.rad_anim_frame_1 %>" alt="Radical animation frame 2">
        <img :class="{'opaque': radicalFrame === 2}" src="<%= doc.rad_anim_frame_2 %>" alt="Radical animation frame 3">
      </div>
    </div>
  </div>

  <!-- Column 3: Info + Strokes, Grade, References, Hint -->
  <div class="col3">
    <div class="row1">
      <button class="info-button" @click="$refs.helpDialog.showModal()">
        <span>Info</span>
      </button>
    </div>
    <div class="row2">
      <h3 class="strokes">Strokes</h3>
      <p class="strokes"><%= doc.kstroke %></p>

      <h3 class="grade">Grade</h3>
      <p class="grade"><%= doc.grade %></p>

      <div class="border4"><div class="border-inner"></div></div>

      <h3 class="kodansha">Kodansha</h3>
      <p class="kodansha"><%= doc.dick %></p>

      <h3 class="nelson">Classic Nelson</h3>
      <p class="nelson"><%= doc.dicn %></p>

      <div class="border5"><div class="border-inner"></div></div>

      <h3 class="hint">Hint</h3>
      <div class="hint" id="ka-hint"><%- doc.hint %></div>

      <div class="border6"><div class="border-inner"></div></div>
    </div>
  </div>

  <!-- Column 4: Branding + Examples -->
  <div class="col4">
    <div class="row1 desktop-branding">
      <a href="https://kanjialive.com" target="_blank" rel="noopener">
        <span class="ka-welcome-italic">Kanji alive</span>
      </a>
    </div>
    <div class="row2">
      <h3 class="examples">Examples</h3>
      <div class="examples">
        <% doc.examples.forEach((example, index) => { %>
          <div class="example">
            <div class="example-text">
              <div class="example-ja example-japanese" lang="ja"><%= example.japanese %></div>
              <div class="example-ja example-english"><%= example.english %></div>
            </div>
            <div class="example-audio">
              <button class="icon-play audio-play ka-icon-gray pointer"
                      data-audio="<%= example.mp3 %>"
                      onclick="playExampleAudio(this.dataset.audio)"
                      aria-label="Play audio"></button>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- Decorative Borders -->
  <div class="border1"><div class="border-inner"></div></div>
  <div class="border2"><div class="border-inner"></div></div>
  <div class="border7"><div class="border-inner"></div></div>

  <!-- Stroke Breakdown -->
  <div class="stroke-breakdown">
    <% doc.strokes.forEach((stroke, index) => { %>
      <img class="ka-breakdown"
           src="<%= stroke %>"
           alt="Stroke <%= index + 1 %>"
           @mouseover="detailMode === 'video' && seek(<%= doc.stroketimes[index + 1] || 0 %>)">
    <% }); %>
  </div>

  <!-- Help Modal -->
  <dialog x-ref="helpDialog" class="help-modal" @click.self="$refs.helpDialog.close()">
    <%- include('../partials/detail-help-modal') %>
  </dialog>

  <!-- Version -->
  <div class="version"><p>v2.1</p></div>
</div>

<!-- Logo -->
<div class="logo">
  <img src="https://media.kanjialive.com/img/fan_logo_104.jpg" alt="Kanji alive logo" loading="lazy"/>
</div>

<!-- Audio element for examples -->
<audio id="example-audio" preload="none" style="display: none;"></audio>
</div>


</body>
</html>
