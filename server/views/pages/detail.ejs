<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="<%= doc.ka_utf %> - <%= doc.meaning %>. Learn to read and write this kanji with Kanji alive."/>
  <title><%= doc.ka_utf %> - <%= doc.meaning %> - Kanji alive</title>

  <!-- CSS -->
  <link href="/static/css/kanji-alive-modern.css" rel="stylesheet">

  <!-- Alpine.js — served from this app, NOT a CDN. A vendored, pinned copy cannot
       become un-fetchable if a package registry disappears, and browsers do not
       break backwards compatibility, so it keeps working regardless of upstream. -->
  <script src="/static/js/libs/alpinejs-3.15.12.min.js" defer></script>

  <%- include('../partials/focus-ring') %>

  <!-- Alpine component + page navigation (runs once, survives content swaps) -->
  <script>
  // Register the detail page component once, before Alpine starts
  document.addEventListener('alpine:init', function() {
    Alpine.data('detailPage', () => ({
      detailMode: 'video',
      playing: false,
      typeface: 'kyokasho',
      typefaceIndex: 4,
      typefaces: ['suzumushi', 'kanteiryu', 'hiragino', 'tensho', 'kyokasho', 'mincho', 'gothic', 'maru'],
      typefaceDisplayNames: {
        'suzumushi': 'Suzumushi',
        'kanteiryu': 'Kanteiryu',
        'hiragino': 'Gyosho',
        'tensho': 'Tensho',
        'kyokasho': 'Kyokashotai',
        'mincho': 'Mincho',
        'gothic': 'Gothic',
        'maru': 'Maru'
      },
      radicalFrame: 0,
      radicalAnimating: false,
      // Radical animation timing. The cross-fade duration lives in CSS
      // (.ka-rad-anim img, currently 1.375s) and is subtracted from the gap, so
      // an image is fully still for (gap - fade) = 250ms. Keep them in step.
      radicalFirstPause: 500,   // click -> frame 1
      radicalFrameGap: 1625,    // frame -> frame (1.375s fade + 250ms still)
      stroketimes: [],

      get typefaceDisplay() {
        return this.typefaceDisplayNames[this.typeface] || this.typeface;
      },

      // Never set this.playing here — the listeners in init() own it.
      togglePlayPause() {
        const video = this.$refs.video;
        if (video.paused) {
          // A blocked start leaves the icon on play, which is the signal. Unhandled it
          // would only spam the console.
          video.play().catch(() => {});
        } else {
          video.pause();
        }
      },

      stepForward() {
        const video = this.$refs.video;
        const currentTime = video.currentTime;
        for (let i = 0; i < this.stroketimes.length; i++) {
          if (this.stroketimes[i] > currentTime + 0.01) {
            this.seek(this.stroketimes[i]);
            return;
          }
        }
        this.seek(video.duration);
      },

      stepBackward() {
        const video = this.$refs.video;
        const currentTime = video.currentTime;
        for (let i = this.stroketimes.length - 1; i >= 0; i--) {
          if (this.stroketimes[i] < currentTime - 0.01) {
            this.seek(this.stroketimes[i]);
            return;
          }
        }
      },

      seek(time) {
        const video = this.$refs.video;
        video.pause();   // the 'pause' listener clears this.playing; do not set it here
        video.currentTime = time;
      },

      nextTypeface() {
        this.typefaceIndex = Math.min(this.typefaceIndex + 1, this.typefaces.length - 1);
        this.typeface = this.typefaces[this.typefaceIndex];
      },

      previousTypeface() {
        this.typefaceIndex = Math.max(this.typefaceIndex - 1, 0);
        this.typeface = this.typefaces[this.typefaceIndex];
      },

      startRadicalAnimation() {
        // Three deliberate departures from Angular (detail-controller.js:198),
        // all chosen by the maintainer 2026-07-12. Recorded here so a future
        // parity sweep does not "correct" them back to production's values.
        //
        //  1. radicalFirstPause is 500ms, not Angular's 1250ms — the animation
        //     used to sit motionless for over a second after the click.
        //  2. radicalFrameGap is 1625ms, not 1250ms. The CSS opacity fade on
        //     .ka-rad-anim img (1.375s, vs production's 1s) is subtracted from
        //     this gap, so an image is FULLY STILL for (gap - fade) = 250ms.
        //     The fade IS the animation — one radical dissolving into the next —
        //     so it takes most of the frame, and the still period is a breath
        //     between transitions rather than a slideshow.
        //  3. Re-entrancy is guarded. Angular has none: clicking mid-animation
        //     schedules an overlapping pass and the frames fight each other.
        //
        // Frames land at 500 / 2125 / 3750ms.
        //
        // The JS timings live on the component (not as consts) so they can be
        // tuned live in the browser console without a rebuild — but the fade is
        // CSS, so change BOTH or the still period drifts:
        //   var d = document.querySelector('.container2')._x_dataStack[0];
        //   d.radicalFrameGap = 1625;
        //   document.querySelectorAll('.ka-rad-anim img')
        //     .forEach(i => i.style.transitionDuration = '1.375s');
        //   document.querySelector('.ka-rad-anim').click();
        if (this.radicalAnimating) return;
        this.radicalAnimating = true;

        const first = this.radicalFirstPause;
        const gap = this.radicalFrameGap;

        setTimeout(() => { this.radicalFrame = 1; }, first);
        setTimeout(() => { this.radicalFrame = 2; }, first + gap);
        setTimeout(() => {
          this.radicalFrame = 0;
          this.radicalAnimating = false;
        }, first + gap * 2);
      },

      // viaKeyboard: hand focus to the swapped-in surface — the activated one goes
      // display:none and focus would fall to the page top, stranding Tab. Mouse
      // clicks pass false: pointerdown never focuses these (focus-ring guard), and
      // moving focus on click would ring a control the user never Tabbed to.
      showTypefaces(viaKeyboard) {
        this.detailMode = 'typeface';
        if (viaKeyboard) this.$nextTick(() => this.$refs.typefaceSurface && this.$refs.typefaceSurface.focus());
      },
      showVideo(viaKeyboard) {
        this.detailMode = 'video';
        if (viaKeyboard) this.$nextTick(() => this.$refs.videoSurface && this.$refs.videoSurface.focus());
      },

      init() {
        this.stroketimes = JSON.parse(this.$el.dataset.stroketimes || '[]');

        // Persist the view mode and chosen typeface across kanji navigation.
        // Prev/next paging replaces .container2 with a freshly-initialised
        // component (see navigateKanji), so without this the mode would reset
        // to 'video' every time you stepped left/right — you'd flip to a new
        // kanji only to be dropped back into the animation. Production keeps
        // these on the singleton searchService (detail-controller.js); the
        // window store is the equivalent that survives a content swap.
        const saved = window._detailViewState;
        if (saved) {
          this.detailMode = saved.detailMode;
          this.typeface = saved.typeface;
          this.typefaceIndex = saved.typefaceIndex;
        }
        const persist = () => {
          window._detailViewState = {
            detailMode: this.detailMode,
            typeface: this.typeface,
            typefaceIndex: this.typefaceIndex,
          };
        };
        this.$watch('detailMode', persist);
        this.$watch('typeface', persist);

        if (window._detailKeydownHandler) {
          document.removeEventListener('keydown', window._detailKeydownHandler);
        }

        // These listeners are the ONLY writer of `playing`, so the icon cannot lie.
        // A Safari extension binding Space paused the video right after play(); with no
        // 'pause' listener the icon stuck on pause and every press re-asserted it.
        const video = this.$refs.video;
        video?.addEventListener('play', () => { this.playing = true; });
        video?.addEventListener('pause', () => { this.playing = false; });
        video?.addEventListener('ended', () => { this.playing = false; });

        const handler = (e) => {
          if (e.target.tagName === 'INPUT') return;

          // A focused control owns Space: preventDefault below would swallow its
          // activation (and the radical-anim div would fire twice — its own Space
          // handler plus this one). Enter never reaches this switch, so only Space.
          if (e.code === 'Space' && e.target.closest('button, [role="button"], a')) return;

          // The Quick Reference is modal: no shortcut may act behind it. ArrowLeft/
          // Right would even replace .container2 and destroy the open dialog.
          // Escape still closes it natively.
          if (this.$refs.helpDialog.open) return;

          // Nothing here wants auto-repeat: a held key fires ~33/sec. Unlike search.ejs,
          // where ArrowLeft/Right scroll and must repeat, these arrows step one kanji.
          // preventDefault still runs, or a held key scrolls the window instead.
          if (e.repeat) {
            if (e.code === 'Space' || e.code === 'ArrowUp' || e.code === 'ArrowDown' ||
                e.code === 'ArrowLeft' || e.code === 'ArrowRight') {
              e.preventDefault();
            }
            return;
          }

          // 'r' — replay the radical animation. The only feature with no key of
          // its own; the radical image was mouse-only in both frontends.
          //
          // Matched on e.key, NOT e.code like the cases below. e.code is the
          // physical key position, so 'KeyR' fires for whatever sits where R is
          // on QWERTY — on Dvorak that is the key that types 'o'. A mnemonic
          // shortcut has to follow the character the user actually typed.
          //
          // Modifiers are excluded so Cmd+R / Ctrl+R (reload) is never hijacked.
          // No preventDefault: a bare 'r' has no default action to suppress, and
          // startRadicalAnimation() already guards against re-entry.
          if (e.key && e.key.toLowerCase() === 'r' && !e.metaKey && !e.ctrlKey && !e.altKey) {
            this.startRadicalAnimation();
            return;
          }

          switch(e.code) {
            case 'Space':
              e.preventDefault();
              this.togglePlayPause();
              break;
            case 'ArrowUp':
            case 'ArrowDown':
              e.preventDefault();
              this.detailMode = this.detailMode === 'video' ? 'typeface' : 'video';
              break;
            case 'ArrowLeft':
              // Safari extends a text selection on Shift+Arrow even with no caret
              // (Chrome needs an existing anchor) — without preventDefault each
              // typeface step also highlights the page from the document edge.
              e.preventDefault();
              if (e.shiftKey) {
                if (this.detailMode === 'typeface') {
                  this.previousTypeface();
                } else {
                  this.stepBackward();
                }
              } else {
                const prevLink = document.querySelector('.recordCounter a.icon-left');
                if (prevLink) prevLink.click();
              }
              break;
            case 'ArrowRight':
              e.preventDefault();
              if (e.shiftKey) {
                if (this.detailMode === 'typeface') {
                  this.nextTypeface();
                } else {
                  this.stepForward();
                }
              } else {
                const nextLink = document.querySelector('.recordCounter a.icon-right');
                if (nextLink) nextLink.click();
              }
              break;
          }
        };
        window._detailKeydownHandler = handler;
        document.addEventListener('keydown', handler);
      },

      destroy() {
        if (window._detailKeydownHandler) {
          document.removeEventListener('keydown', window._detailKeydownHandler);
          window._detailKeydownHandler = null;
        }
      }
    }));
  });

  // DETAIL-NAV-START — detail-nav.test.ts lifts this region and runs it. Keep the markers.
  var _latestNavRequest = 0;
  var _inFlightNav = null;

  // Prev/next via fetch + DOM swap. Alpine's MutationObserver initialises the replaced
  // subtree — never reintroduce a swap library, its settling races the observer.
  // The chevrons and ArrowLeft/Right (which .click() them) both land here, so requests
  // overlap easily. Abort spares the server; the stamp is the correctness guarantee,
  // because a response already past the abort point still resolves.
  window.navigateKanji = async function(url, e) {
    e.preventDefault();

    if (_inFlightNav) _inFlightNav.abort();
    var controller = new AbortController();
    _inFlightNav = controller;
    var requestId = ++_latestNavRequest;

    try {
      var r = await fetch(url, { signal: controller.signal });
      if (requestId !== _latestNavRequest) return;

      var html = await r.text();
      if (requestId !== _latestNavRequest) return;

      var doc = new DOMParser().parseFromString(html, 'text/html');
      var nc = doc.querySelector('.container2');
      if (!nc) throw new Error('missing container');
      document.querySelector('.container2').replaceWith(nc);
      history.pushState(null, '', url.replace(/\?.*$/, ''));
      if (nc.dataset.title) document.title = nc.dataset.title;

      // replaceWith destroyed the focused node: announce the new kanji and land
      // focus on its heading, or keyboard users silently restart from <body>.
      var status = document.getElementById('a11y-status');
      if (status) {
        var counter = document.querySelector('.recordCounter .search a');
        status.textContent = (nc.dataset.title || '').replace(/ - Kanji alive$/, '') +
          (counter ? ', ' + counter.textContent : '');
      }
      var heading = document.querySelector('.container2 h1');
      if (heading) heading.focus();
    } catch(err) {
      // A superseded navigation is not a failure, and the fallback below is a HARD page
      // load — without this, aborting yanks the browser to a kanji already left.
      if (err.name === 'AbortError' || requestId !== _latestNavRequest) return;
      window.location.href = url;
    }
  };
  // DETAIL-NAV-END

  // Handle browser back/forward after pushState navigation
  window.addEventListener('popstate', function() {
    window.location.reload();
  });

  // Example audio playback (in head so it survives content swaps)
  window.playExampleAudio = function(src) {
    var audio = document.getElementById('example-audio');
    if (audio) { audio.src = src; audio.play(); }
  };
  </script>

  <base href="/">
</head>
<body>

<div class="container">
<%# <main>, not <div>: the page's one main landmark. navigateKanji() and the CSS
    select by .container2, so the tag change is invisible to both. %>
<main class="container2" x-data="detailPage()" data-stroketimes='<%= JSON.stringify(doc.stroketimes) %>' data-title="<%= doc.ka_utf %> - <%= doc.meaning %> - Kanji alive">

  <%# tabindex="-1": navigateKanji() lands focus here after a swap. %>
  <h1 class="visually-hidden" tabindex="-1"><%= doc.ka_utf %> — <%= doc.meaning %></h1>

  <%
  // Navigation context (computed server-side from search results)
  const idx = typeof currentIndex !== 'undefined' ? currentIndex : 0;
  const total = typeof totalResults !== 'undefined' ? totalResults : 1;
  const prev = typeof prevKanji !== 'undefined' ? prevKanji : null;
  const next = typeof nextKanji !== 'undefined' ? nextKanji : null;
  const qs = typeof queryString !== 'undefined' ? queryString : '';

  // Build nav URLs — just kanji + search params (server computes neighbors)
  const prevUrl = prev
    ? `/${encodeURIComponent(prev)}${qs}`
    : '';
  const nextUrl = next
    ? `/${encodeURIComponent(next)}${qs}`
    : '';
  %>

  <!-- Column 1: Search Form + Video/Typeface -->
  <div class="col1">
    <div class="row1">
      <form class="search-form" role="search" action="/search" method="get">
        <input type="text"
               name="q"
               id="search-input"
               class="search-bar"
               aria-label="Search for kanji"
               value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>"
               spellcheck="false"
               autocapitalize="off"
               autocorrect="off">
        <button type="submit" class="search-button" aria-label="Search"></button>
      </form>
    </div>
    <div class="row2">
      <h3 id="kanji" aria-level="2">Kanji</h3>

      <div class="container-typeface-video">
        <!-- Video Mode -->
        <div class="video-container" x-show="detailMode === 'video'">
          <%# Sibling, not a child of <video>: content inside <video> is fallback for
              unsupported browsers and is not reliably exposed to the a11y tree.
              aria-hidden: a label source, not content — without it VoiceOver stops
              on it as a phantom item. aria-labelledby resolves into hidden elements. %>
          <div id="video-label" class="visually-hidden" aria-hidden="true">Stroke order animation for <span lang="ja"><%= doc.ka_utf %></span></div>
          <%# The toggle surface is a keyboard control (role=button on the div, not a
              real <button> — UA styling would move ink). The label names the ACTION;
              the video keeps its descriptive name. Space/Enter: the global Space
              shortcut already yields to a focused [role=button]. %>
          <div class="video" x-ref="videoSurface" role="button" tabindex="0" aria-label="Show typefaces"
               @click="showTypefaces(false)"
               @keydown.enter.prevent="showTypefaces(true)"
               @keydown.space.prevent="showTypefaces(true)">
            <video x-ref="video"
                   aria-labelledby="video-label"
                   poster="<%= doc.poster_video_source %>"
                   playsinline
                   preload="metadata">
              <source src="<%= doc.mp4_video_source %>" type="video/mp4">
              <source src="<%= doc.webm_video_source %>" type="video/webm">
            </video>
          </div>
          <div class="animation-controls">
            <button class="icon-step-left ka-icon-gray pointer"
                    @click="stepBackward()"
                    aria-label="Step backward"></button>
            <button :class="playing ? 'icon-pause' : 'icon-play'"
                    class="ka-icon-gray pointer"
                    @click="togglePlayPause()"
                    :aria-label="playing ? 'Pause stroke order animation' : 'Play stroke order animation'"
                    aria-label="Play stroke order animation"></button>
            <button class="icon-step-right ka-icon-gray pointer"
                    @click="stepForward()"
                    aria-label="Step forward"></button>
          </div>
        </div>

        <!-- Typeface Mode -->
        <div id="ka-typeface-container" x-show="detailMode === 'typeface'" x-cloak>
          <%# Same shape as the video surface above. %>
          <div class="ka-typefaces" x-ref="typefaceSurface" role="button" tabindex="0" aria-label="Show stroke order animation"
               @click="showVideo(false)"
               @keydown.enter.prevent="showVideo(true)"
               @keydown.space.prevent="showVideo(true)">
            <img x-show="typeface === 'tensho'" src="<%= doc.tensho_source %>" alt="Tensho typeface">
            <img x-show="typeface === 'kyokasho'" src="<%= doc.kyokasho_source %>" alt="Kyokasho typeface">
            <img x-show="typeface === 'maru'" src="<%= doc.maru_source %>" alt="Maru typeface">
            <img x-show="typeface === 'mincho'" src="<%= doc.mincho_source %>" alt="Mincho typeface">
            <img x-show="typeface === 'gothic'" src="<%= doc.gothic_source %>" alt="Gothic typeface">
            <img x-show="typeface === 'hiragino'" src="<%= doc.hiragino_source %>" alt="Hiragino typeface">
            <img x-show="typeface === 'kanteiryu'" src="<%= doc.kanteiryu_source %>" alt="Kanteiryu typeface">
            <img x-show="typeface === 'suzumushi'" src="<%= doc.suzumushi_source %>" alt="Suzumushi typeface">
          </div>
          <div class="animation-controls">
            <%# aria-disabled, not disabled: the ends must announce as unavailable
                without picking up the UA's disabled styling. %>
            <button @click="previousTypeface()" class="ka-typeface-left pointer" aria-label="Previous typeface" :aria-disabled="typefaceIndex === 0">&#12296;</button>
            <span class="typeface-name" x-html="typefaceDisplay" aria-live="polite"></span>
            <button @click="nextTypeface()" class="ka-typeface-right pointer" aria-label="Next typeface" :aria-disabled="typefaceIndex === typefaces.length - 1">&#12297;</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Column 2: Navigation + Meaning, Readings, Radical -->
  <div class="col2">
    <div class="row1">
      <div class="recordCounter">
        <% if (prev) { %>
          <a class="icon icon-left" href="<%= prevUrl %>" onclick="navigateKanji(this.href, event)" aria-label="Previous kanji">&#12296;</a>
        <% } else { %>
          <span class="icon icon-left disabled" aria-hidden="true">&#12296;</span>
        <% } %>
        <span class="search">
          <% if (typeof lastSearch !== 'undefined' && lastSearch) { %>
            <a href="<%= lastSearch %>" aria-label="Back to search results, kanji <%= idx + 1 %> of <%= total %>"><%= idx + 1 %> of <%= total %></a>
          <% } else { %>
            <%# production always renders the counter as a link (falls back to a
                single-kanji search) — the .row1 a rule gives it 17px rust %>
            <a href="/search?q=<%= encodeURIComponent(doc.ka_utf) %>" aria-label="Back to search">1 of 1</a>
          <% } %>
        </span>
        <% if (next) { %>
          <a class="icon icon-right" href="<%= nextUrl %>" onclick="navigateKanji(this.href, event)" aria-label="Next kanji">&#12297;</a>
        <% } else { %>
          <span class="icon icon-right disabled" aria-hidden="true">&#12297;</span>
        <% } %>
      </div>
    </div>
    <div class="row2">
      <h3 class="meaning" aria-level="2">Meaning</h3>
      <p class="meaning"><%= doc.meaning %></p>

      <h3 class="onyomi" aria-level="2">Onyomi</h3>
      <%# lang="ja" is load-bearing, not decoration. The page is lang="en"; when font
          fallback reaches the generic, the browser picks the CJK face by DOCUMENT
          language — and macOS then hands back PingFang SC, i.e. CHINESE glyph forms
          (verified: a 0.00% pixel match against PingFang SC). 骨 直 画 角 are drawn
          differently in Chinese, and this app teaches the Japanese strokes. Marking the
          text as Japanese makes even the generic resolve to Hiragino Sans. %>
      <%_ /* No onyomi is recorded as `onyomi: "n/a"` with `onyomi_ja` empty (13 kanji).
              Test the romaji sentinel, not an empty `onyomi_ja` — the record's own
              statement of absence, so a mistakenly blank field can't print "n/a". */ _%>
      <p class="onyomi" lang="ja"><%= doc.onyomi === "n/a" ? "n/a" : doc.onyomi_ja %></p>

      <h3 class="kunyomi" aria-level="2">Kunyomi</h3>
      <p class="kunyomi" lang="ja"><%= doc.kunyomi_ka_display %></p>

      <div class="border3"><div class="border-inner"></div></div>

      <h3 class="radical" aria-level="2">Radical</h3>
      <%# VoiceOver walks this panel in DOM order; the maintainer specified the
          visual reading order (2026-07-30): glyph, reading, meaning, strokes,
          position, animation. Every element is absolutely positioned, so the DOM
          follows speech order without moving a pixel. role="img": Safari otherwise
          exposes the SVG file's internal tree as extra VoiceOver stops — its
          Sketch-export <title>, empty layer groups, "Created with Sketch." %>
      <% if (doc.rad_name_ja && doc.rad_name && doc.rad_name !== "n/a") { %>
        <%# Split-language name: "Radical" needs the English voice, the name the
            Japanese one — a flat alt inherits a single language. aria-hidden: this
            span is a label source, not content — without it VoiceOver stops on it
            as a phantom item. aria-labelledby resolves into hidden elements. %>
        <span id="radical-label" class="visually-hidden" aria-hidden="true">Radical image: <span lang="ja"><%= doc.rad_name_ja %></span></span>
        <img class="radical-character" role="img" aria-labelledby="radical-label" src="<%= doc.rad_char_source %>" alt="<%= doc.rad_name_ja %>">
      <% } else { %>
        <%# No role="img" here: alt="" hides the image, and an explicit role would
            re-expose it as a nameless stop. %>
        <img class="radical-character" src="<%= doc.rad_char_source %>" alt="">
      <% } %>
      <%# Hidden English prefixes name each value, matching "Radical position: hen"
          (his spec, 2026-08-01); the colon paces the speech. Prefixes are REAL text
          in the page language, the name a lang="ja" run — never aria-labels. %>
      <div class="radical-name"><span class="visually-hidden">Radical name: </span><span lang="ja"><%= doc.rad_name_ja %></span></div>
      <%# &nbsp;, not a space: VoiceOver trims a text run's trailing whitespace, so
          a plain space vanished and the caption read "Radical meaning:words". %>
      <div class="radical-meaning"><span class="visually-hidden">Radical meaning:&nbsp;</span><%= doc.rad_meaning %></div>
      <%_ /* Only 々 reaches this as NaN (it has no radical strokes). Same sentinel, same
              production behaviour: blank — and no sr-only prefix announcing a blank. */ _%>
      <% const radStroke = numberOrBlank(doc.rad_stroke); %>
      <div class="radical-stroke"><% if (radStroke !== "") { %><span class="visually-hidden">Radical strokes:&nbsp;</span><% } %><%= radStroke %></div>
      <% if (doc.rad_position && doc.rad_position_file) { %>
        <%# The icon depicts the LAST listed position — same derivation as its filename. %>
        <img class="radical-position" role="img" src="<%= doc.rad_position_file %>" alt="Radical position: <%= doc.rad_position.split(",").pop().trim() %>">
      <% } %>

      <%# role="button" on the div, not a real <button>: a <button> picks up UA styling
          (WebKit's asymmetric padding among it) and would move ink on a frozen UI. %>
      <div class="ka-rad-anim pointer" role="button" tabindex="0"
           aria-label="Play radical animation"
           @click="startRadicalAnimation()"
           @keydown.enter.prevent="startRadicalAnimation()"
           @keydown.space.prevent="startRadicalAnimation()">
        <img :class="{'opaque': radicalFrame === 0}" src="<%= doc.rad_anim_frame_0 %>" alt="">
        <img :class="{'opaque': radicalFrame === 1}" src="<%= doc.rad_anim_frame_1 %>" alt="">
        <img :class="{'opaque': radicalFrame === 2}" src="<%= doc.rad_anim_frame_2 %>" alt="">
      </div>
    </div>
  </div>

  <!-- Column 3: Info + Strokes, Grade, References, Hint -->
  <div class="col3">
    <div class="row1">
      <button class="info-button" @click="$refs.helpDialog.showModal()">
        <span>Info</span>
      </button>
    </div>
    <div class="row2">
      <h3 class="strokes" aria-level="2">Strokes</h3>
      <p class="strokes"><%= doc.kstroke %></p>

      <h3 class="grade" aria-level="2">Grade</h3>
      <%_ /* 229 kanji have no grade, stored as the NaN sentinel that `?grade=` searches
              on. Production renders it blank (its NaN becomes null crossing JSON); print
              the raw value here and the student reads "NaN". 々 alone says "n/a" — it is
              not a kanji, so no grade can apply (maintainer's ruling, 2026-07-28). */ _%>
      <p class="grade"><%= doc.ka_utf === "々" ? "n/a" : numberOrBlank(doc.grade) %></p>

      <div class="border4"><div class="border-inner"></div></div>

      <h3 class="kodansha" aria-level="2">Kodansha</h3>
      <p class="kodansha"><%= doc.dick %></p>

      <h3 class="nelson" aria-level="2">Classic Nelson</h3>
      <p class="nelson"><%= doc.dicn %></p>

      <div class="border5"><div class="border-inner"></div></div>

      <h3 class="hint" aria-level="2">Hint</h3>
      <div class="hint" id="ka-hint"><%- doc.hint %></div>

      <div class="border6"><div class="border-inner"></div></div>
    </div>
  </div>

  <!-- Column 4: Branding + Examples -->
  <div class="col4">
    <div class="row1 desktop-branding">
      <a href="https://kanjialive.com" target="_blank" rel="noopener" aria-label="Kanji alive website (opens in new tab)">
        <span class="ka-welcome-italic">Kanji alive</span>
      </a>
    </div>
    <div class="row2">
      <h3 class="examples" aria-level="2">Examples</h3>
      <div class="examples">
        <% doc.examples.forEach((example, index) => { %>
          <div class="example">
            <div class="example-text">
              <div class="example-ja example-japanese" lang="ja"><%= example.japanese %></div>
              <div class="example-ja example-english"><%= example.english %></div>
            </div>
            <div class="example-audio">
              <%# "Play pronunciation", nothing more — "of <word>" was cut as too
                  verbose (his ruling, 2026-08-01): the word is the row just read.
                  aria-label, not name-from-content: the label keeps the CSS play
                  glyph (a private-use character) out of the announcement. %>
              <button class="icon-play audio-play ka-icon-gray pointer"
                      data-audio="<%= example.mp3 %>"
                      aria-label="Play pronunciation"
                      onclick="playExampleAudio(this.dataset.audio)"></button>
            </div>
          </div>
        <% }); %>
      </div>
    </div>
  </div>

  <!-- Decorative Borders -->
  <div class="border1"><div class="border-inner"></div></div>
  <div class="border2"><div class="border-inner"></div></div>
  <div class="border7"><div class="border-inner"></div></div>

  <!-- Stroke Breakdown -->
  <div class="stroke-breakdown">
    <% doc.strokes.forEach((stroke, index) => { %>
      <img class="ka-breakdown"
           src="<%= stroke %>"
           alt="Stroke <%= index + 1 %>"
           @mouseover="detailMode === 'video' && seek(<%= doc.stroketimes[index + 1] || 0 %>)">
    <% }); %>
  </div>

  <!-- Help Modal -->
  <dialog x-ref="helpDialog" class="help-modal" aria-labelledby="help-modal-title" @click.self="$refs.helpDialog.close()">
    <%- include('../partials/detail-help-modal') %>
  </dialog>

  <!-- Version -->
  <div class="version"><p>v2.1</p></div>
</main>

<!-- Announces prev/next swaps. OUTSIDE .container2: navigateKanji() replaces
     that node wholesale, and a live region must pre-exist the mutation. -->
<div id="a11y-status" class="visually-hidden" role="status"></div>

<!-- Logo -->
<div class="logo">
  <img src="https://media.kanjialive.com/img/fan_logo_104.jpg" alt="Kanji alive logo" loading="lazy"/>
</div>

<!-- Audio element for examples -->
<audio id="example-audio" preload="none" style="display: none;"></audio>
</div>


</body>
</html>
