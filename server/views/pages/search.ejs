<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Kanji alive is a free web application designed to help Japanese language students of all levels learn to read and write kanji."/>
  <%# Query-first, matching the detail pages ("女 - woman - Kanji alive"): the
      distinctive part survives tab truncation, and a bookmark is offered a
      descriptive name. loadResults() keeps it current via the X-Title header. %>
  <title><%= typeof query !== 'undefined' && query ? query + ' - Kanji alive' : 'Kanji alive Web Application' %></title>

  <!-- CSS -->
  <link href="/static/css/kanji-alive-modern.css" rel="stylesheet">

  <!-- Alpine.js — served from this app, NOT a CDN. A vendored, pinned copy cannot
       become un-fetchable if a package registry disappears, and browsers do not
       break backwards compatibility, so it keeps working regardless of upstream. -->
  <script src="/static/js/libs/alpinejs-3.15.12.min.js" defer></script>

  <%- include('../partials/focus-ring') %>

  <!-- Results loading. Replaces HTMX, which was only ever doing this one job.
       Kept in <head> so it survives content swaps. -->
  <script>
  // LOAD-RESULTS-START — results-race.test.ts lifts this region and runs it. Keep the markers.
  var _latestResultsRequest = 0;
  var _inFlightResults = null;

  // The scrollbar track is a CHILD of the swap target, so a naive swap destroys it and
  // the querySelector below then returns null forever — one failed search used to kill
  // the scrollbar for every later search. Detach, swap, re-append the SAME node so
  // Alpine's $refs stay valid. Keep it one shared function or the two paths drift.
  function _swapResults(target, html) {
    var track = target.querySelector('.custom-scrollbar-track');
    if (track) track.remove();
    target.innerHTML = html;
    if (track) target.appendChild(track);
  }

  window.loadResults = async function (url) {
    var target = document.getElementById('search-results');

    // Requests overlap routinely — no slow network needed, just a held arrow key
    // (~33/sec via cycleMode). Abort spares the server; the stamp is the correctness
    // guarantee, because a response already past the abort point still resolves.
    if (_inFlightResults) _inFlightResults.abort();
    var controller = new AbortController();
    _inFlightResults = controller;
    var requestId = ++_latestResultsRequest;

    try {
      var res = await fetch(url, { signal: controller.signal });
      if (requestId !== _latestResultsRequest) return;

      // Server asks the browser to navigate instead (colon-syntax queries)
      var redirect = res.headers.get('X-Redirect');
      if (redirect) { window.location.href = redirect; return; }

      var html = await res.text();
      if (requestId !== _latestResultsRequest) return;

      if (!res.ok) throw new Error('Search failed: ' + res.status);

      _swapResults(target, html);

      // Show the full-page URL, not the partial endpoint
      var pushUrl = res.headers.get('X-Push-Url');
      if (pushUrl) history.pushState(null, '', pushUrl);

      // Keep the tab/bookmark name in step with that URL. Percent-encoded on
      // the wire — headers cannot carry raw Japanese.
      var title = res.headers.get('X-Title');
      if (title) document.title = decodeURIComponent(title);

      // Alpine's MutationObserver initialises the new subtree on its own; this
      // just tells the page component to re-measure the custom scrollbar.
      document.dispatchEvent(new CustomEvent('results:loaded'));
    } catch (err) {
      // A superseded request is not a failure: without this, every aborted request
      // paints "something went wrong" over perfectly good results.
      if (err.name === 'AbortError' || requestId !== _latestResultsRequest) return;

      // Fail loudly: a database outage must not look like an empty result set.
      // .no-results is absolutely positioned against .scroller — without that
      // wrapper the message lands 23px high (see no-results.ejs).
      _swapResults(target,
        '<div class="scroller scroller-kanji">' +
        '<div class="search-results search-results-kanji" style="width: 266px">' +
        '<p class="no-results">Sorry, something went wrong. Please try again.</p>' +
        '</div></div>');

      // The announcer listens for this event; an error swap must announce too.
      document.dispatchEvent(new CustomEvent('results:loaded'));
    }
  };
  // LOAD-RESULTS-END

  // Alpine component registration (in head so it survives content swaps)
  document.addEventListener('alpine:init', () => {
    Alpine.data('searchPage', () => {
      var _animFrame = null;
      return {
      // Read page-specific data from data-* attributes on the container
      mode: 'kanji',
      modes: ['kanji', 'rsort', 'ksort'],
      queryString: '',

      // Auto-repeat must not cycle: a held key fires ~33/sec. Scoped to the MODE keys
      // only — ArrowLeft/Right scroll, where repeating is the point.
      // BOTH call sites route through here: the global handler skips INPUTs, so the
      // search box has its own bindings, and that is the common case after a search.
      cycleModeKey(event, direction) {
        if (event.repeat) return;
        this.cycleMode(direction);
      },

      cycleMode(direction) {
        const currentIndex = this.modes.indexOf(this.mode);
        const newIndex = (currentIndex + direction + this.modes.length) % this.modes.length;
        this.mode = this.modes[newIndex];
        this.currentGroup = 0;

        // Build URL for the results request
        let url = '/htmx/partials/results';
        const input = document.getElementById('search-input');

        if (this.queryString) {
          // Advanced search - use stored query string, update mode
          const params = new URLSearchParams(this.queryString);
          params.set('mode', this.mode);
          url += '?' + params.toString();
        } else if (input.value) {
          // Basic search - use input value
          url += '?q=' + encodeURIComponent(input.value) + '&mode=' + this.mode;
        } else {
          return; // No search to cycle
        }

        loadResults(url);
      },

      submitSearch() {
        // New basic search from the form. Clear stored advanced state first so
        // cycleMode() uses the input value, not stale advanced params.
        this.queryString = '';
        this.mode = 'kanji';
        this.currentGroup = 0;

        const input = document.getElementById('search-input');
        const url =
          '/htmx/partials/results?q=' + encodeURIComponent(input.value);
        loadResults(url);
      },

      currentGroup: 0,

      // Shared by the live-region announcement and the Sort button's label.
      modeNames: {
        kanji: 'sorted by kanji strokes',
        rsort: 'grouped by radical strokes',
        ksort: 'grouped by kanji strokes'
      },

      _updateScrollThumb() {
        var scroller = this.$refs.resultsContainer?.querySelector('.scroller');
        var thumb = this.$refs.scrollThumb;
        if (!scroller || !thumb) return;
        var sw = scroller.scrollWidth;
        var ow = scroller.offsetWidth;
        if (sw <= ow) { thumb.style.display = 'none'; return; }
        thumb.style.display = '';
        var thumbW = Math.max(30, (ow / sw) * ow);
        var maxSL = sw - ow;
        var sRatio = maxSL > 0 ? scroller.scrollLeft / maxSL : 0;
        thumb.style.width = thumbW + 'px';
        thumb.style.left = (sRatio * (ow - thumbW)) + 'px';
      },

      // Compose a polite announcement from the freshly swapped DOM. Reads the
      // DOM rather than component state so error and no-results swaps are
      // announced with their own text.
      _announceResults() {
        var status = document.getElementById('a11y-status');
        var c = this.$refs.resultsContainer;
        if (!status || !c) return;
        var message = c.querySelector('.no-results');
        if (message) {
          status.textContent = message.textContent;
          return;
        }
        var n = c.querySelectorAll('a.ka').length;
        status.textContent = n + ' kanji found, ' + (this.modeNames[this.mode] || '');
      },

      _smoothScroll(el, target) {
        // Honour the OS "reduce motion" setting: same destination, no 900ms glide.
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          el.scrollLeft = target;
          return;
        }

        if (_animFrame) {
          cancelAnimationFrame(_animFrame);
          _animFrame = null;
        }

        var start = el.scrollLeft;
        var change = Math.round(target - start);
        if (!change) return;
        var startTime = performance.now();
        var saved = el.style.scrollBehavior;
        el.style.scrollBehavior = 'auto';

        function ease(t) {
          return t < 0.5 ? 2 * t * t : 1 - 2 * (1 - t) * (1 - t);
        }

        function step(now) {
          var t = Math.min((now - startTime) / 900, 1);
          el.scrollLeft = start + Math.ceil(change * ease(t));
          if (t < 1) {
            _animFrame = requestAnimationFrame(step);
          } else {
            el.style.scrollBehavior = saved;
            _animFrame = null;
          }
        }

        _animFrame = requestAnimationFrame(step);
      },

      // The last group that can actually be parked at the left inset.
      //
      // NOT groups.length - 1. That is the last group that EXISTS; the trailing groups
      // start beyond maxScroll, so the browser clamps the scroll and they never reach the
      // left edge — they are already fully on screen in the final viewport, with nothing
      // left to scroll to. Advancing currentGroup into them desynchronises the index from
      // the view: the view sits at the end while the index climbs, and every ArrowLeft
      // afterwards steps back through groups that all clamp to the same scrollLeft, moving
      // NOTHING, until the index drops below this bound. It reads as though the extra
      // ArrowRight presses were cached and have to be paid back one for one.
      // (grade:1 rsort had three such groups = three dead presses. Reported 2026-07-17.)
      //
      // Derive the bound from the scroller, never from the element count.
      _lastAlignableGroup(scroller, groups) {
        var maxScroll = scroller.scrollWidth - scroller.offsetWidth;
        for (var i = groups.length - 1; i >= 0; i--) {
          if (groups[i].offsetLeft <= maxScroll) return i;
        }
        return 0;
      },

      scrollForward() {
        var scroller = this.$refs.resultsContainer?.querySelector('.scroller');
        if (!scroller) return;

        if (this.mode === 'kanji') {
          // Reads the LIVE scrollLeft, which the browser has already clamped, so this
          // branch cannot bank presses the way the group branch could.
          this._smoothScroll(scroller, scroller.scrollLeft + scroller.offsetWidth);
        } else {
          var groups = scroller.querySelectorAll('.results-group');
          if (groups.length === 0) return;
          this.currentGroup = Math.min(this._lastAlignableGroup(scroller, groups), this.currentGroup + 1);
          this._smoothScroll(scroller, Math.max(0, groups[this.currentGroup].offsetLeft));
        }
      },

      scrollBackward() {
        var scroller = this.$refs.resultsContainer?.querySelector('.scroller');
        if (!scroller) return;

        if (this.mode === 'kanji') {
          this._smoothScroll(scroller, Math.max(0, scroller.scrollLeft - scroller.offsetWidth));
        } else {
          var groups = scroller.querySelectorAll('.results-group');
          if (groups.length === 0) return;
          this.currentGroup = Math.max(0, this.currentGroup - 1);
          this._smoothScroll(scroller, Math.max(0, groups[this.currentGroup].offsetLeft));
        }
      },

      handleWheel(event) {
        var scroller = this.$refs.resultsContainer?.querySelector('.scroller');
        if (!scroller) return;
        if (Math.abs(event.deltaY) > Math.abs(event.deltaX)) {
          event.preventDefault();
          scroller.scrollLeft += event.deltaY;
        }
      },

      startThumbDrag(event) {
        event.preventDefault();
        var scroller = this.$refs.resultsContainer?.querySelector('.scroller');
        var thumb = this.$refs.scrollThumb;
        var track = this.$refs.scrollTrack;
        if (!scroller || !thumb) return;
        var startX = event.clientX;
        var startScrollLeft = scroller.scrollLeft;
        var maxThumbTravel = scroller.offsetWidth - thumb.offsetWidth;
        var maxScroll = scroller.scrollWidth - scroller.offsetWidth;
        if (maxThumbTravel <= 0 || maxScroll <= 0) return;
        // Imperative class toggle keeps the bar visible while the cursor is
        // outside the wrapper mid-drag (CSS :hover alone would fade it)
        if (track) track.classList.add('sb-dragging');
        var onMove = function (ev) {
          scroller.scrollLeft = startScrollLeft + (ev.clientX - startX) * (maxScroll / maxThumbTravel);
        };
        var onUp = function () {
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onUp);
          if (track) track.classList.remove('sb-dragging');
        };
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      },

      init() {
        // Read page-specific state from data-* attributes
        this.mode = this.$el.dataset.mode || 'kanji';
        this.queryString = this.$el.dataset.querystring || '';

        var self = this;

        // Update custom scrollbar on scroll (capture phase catches child .scroller)
        this._scrollHandler = function() { self._updateScrollThumb(); };
        this.$refs.resultsContainer.addEventListener('scroll', this._scrollHandler, true);

        // Re-measure the custom scrollbar after new results are swapped in
        this._settleHandler = function() {
          self._updateScrollThumb();
          self._announceResults();
        };
        document.addEventListener('results:loaded', this._settleHandler);

        // Initial update
        this._updateScrollThumb();

        // Keyboard shortcuts for arrow keys
        this._keyHandler = (e) => {
          if (e.target.tagName === 'INPUT') return;

          // The Quick Reference is modal: arrows must not cycle the sort mode
          // (and announce the swap) behind it. Escape still closes it natively.
          if (this.$refs.helpDialog.open) return;

          switch(e.code) {
            case 'ArrowUp':
              e.preventDefault();
              this.cycleModeKey(e, -1);
              break;
            case 'ArrowDown':
              e.preventDefault();
              this.cycleModeKey(e, 1);
              break;
            case 'ArrowLeft':
              this.scrollBackward();
              break;
            case 'ArrowRight':
              this.scrollForward();
              break;
          }
        };
        document.addEventListener('keydown', this._keyHandler);
      },

      destroy() {
        if (this._settleHandler) {
          document.removeEventListener('results:loaded', this._settleHandler);
        }
        if (this._keyHandler) {
          document.removeEventListener('keydown', this._keyHandler);
        }
        if (this._scrollHandler && this.$refs.resultsContainer) {
          this.$refs.resultsContainer.removeEventListener('scroll', this._scrollHandler, true);
        }
      }
    };
    });
  });
  </script>

  <base href="/">
</head>
<body>

<div class="container">
<div class="container2" x-data="searchPage()" data-mode="<%= typeof mode !== 'undefined' ? mode : 'kanji' %>" data-querystring="<%= typeof queryString !== 'undefined' ? queryString.replace(/"/g, '&quot;') : '' %>">

  <h1 class="visually-hidden">Kanji alive — search for kanji</h1>

  <!-- Header Row -->
  <header class="header-row">
    <!-- Search Form -->
    <div class="col1">
      <div class="row1">
        <form class="search-form" @submit.prevent="submitSearch()">
          <input type="text"
                 name="q"
                 id="search-input"
                 class="search-bar"
                 aria-label="Search for kanji"
                 value="<%= typeof query !== 'undefined' ? query : '' %>"
                 spellcheck="false"
                 autocapitalize="off"
                 autocorrect="off"
                 @keydown.up.prevent="cycleModeKey($event, -1)"
                 @keydown.down.prevent="cycleModeKey($event, 1)">
          <button type="submit" class="search-button" aria-label="Search"></button>
        </form>
      </div>
    </div>

    <!-- Sort Controls -->
    <div class="col2">
      <div class="row1">
        <div class="recordCounter">
          <button class="icon icon-left"
                  @click="scrollBackward()"
                  aria-label="Scroll left">&#12296;</button>
          <span class="search">
            <%# The live region reports the mode after cycling; this tells a screen
                reader the CURRENT mode on landing. %>
            <button @click="cycleMode(1)" class="sort-button"
                    :aria-label="'Sort — currently ' + (modeNames[mode] || '')">Sort</button>
          </span>
          <button class="icon icon-right"
                  @click="scrollForward()"
                  aria-label="Scroll right">&#12297;</button>
        </div>
      </div>
    </div>

    <!-- Info Button -->
    <div class="col3">
      <div class="row1">
        <button class="info-button" @click="$refs.helpDialog.showModal()">
          <span>Info</span>
        </button>
      </div>
    </div>

    <!-- Branding -->
    <div class="col4">
      <div class="row1 desktop-branding">
        <a href="https://kanjialive.com" target="_blank" rel="noopener" aria-label="Kanji alive website (opens in new tab)">
          <span class="ka-welcome-italic">Kanji alive</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Decorative Borders -->
  <div class="border1"><div class="border-inner"></div></div>
  <div class="border2"><div class="border-inner"></div></div>

  <!-- Results Container -->
  <main id="search-results"
        class="row3 scrollbar-wrapper"
        x-ref="resultsContainer"
        @wheel="handleWheel($event)">
    <% if (typeof error !== 'undefined' && error) { %>
      <%- include('../partials/error', { error }) %>
    <% } else if (typeof results !== 'undefined' && results.length > 0) { %>
      <%- include('../partials/results', { results, mode, kanjiStrokeGroups, radicalStrokeGroups, query, resultsOrder }) %>
    <% } else if (typeof query !== 'undefined' && query) { %>
      <%- include('../partials/no-results') %>
    <% } else { %>
      <%- include('../partials/welcome') %>
    <% } %>
    <div class="custom-scrollbar-track" x-ref="scrollTrack">
      <div class="custom-scrollbar-thumb" x-ref="scrollThumb" @mousedown="startThumbDrag($event)"></div>
    </div>
  </main>

  <!-- Announces result swaps to screen readers. OUTSIDE the swap target:
       loadResults() replaces #search-results' children, and a live region
       must pre-exist a mutation to be announced. -->
  <div id="a11y-status" class="visually-hidden" role="status"></div>

  <!-- Help Modal -->
  <dialog x-ref="helpDialog" class="help-modal" @click.self="$refs.helpDialog.close()">
    <%- include('../partials/search-help-modal') %>
  </dialog>

  <!-- Version -->
  <div class="version"><p>v2.1</p></div>
</div>

<!-- Logo -->
<div class="logo">
  <img src="https://media.kanjialive.com/img/fan_logo_104.jpg" alt="Kanji alive logo" loading="lazy"/>
</div>
</div>


</body>
</html>
