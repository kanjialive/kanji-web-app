<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Kanji alive is a free web application designed to help Japanese language students of all levels learn to read and write kanji."/>
  <title><%= typeof query !== 'undefined' && query ? 'Search: ' + query + ' - ' : '' %>Kanji alive Web Application</title>

  <!-- CSS -->
  <link href="/static/css/kanji-alive-modern.css" rel="stylesheet">

  <!-- HTMX + Alpine.js -->
  <script src="https://unpkg.com/htmx.org@2.0.4" defer></script>
  <script src="https://unpkg.com/alpinejs@3.14.8/dist/cdn.min.js" defer></script>

  <!-- Alpine component registration (in head so it survives any HTMX body swaps) -->
  <script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('searchPage', () => {
      var _animFrame = null;
      return {
      // Read page-specific data from data-* attributes on the container
      mode: 'kanji',
      modes: ['kanji', 'rsort', 'ksort'],
      queryString: '',

      cycleMode(direction) {
        const currentIndex = this.modes.indexOf(this.mode);
        const newIndex = (currentIndex + direction + this.modes.length) % this.modes.length;
        this.mode = this.modes[newIndex];
        this.currentGroup = 0;

        // Build URL for HTMX request
        let url = '/htmx/partials/results';
        const input = document.getElementById('search-input');

        if (this.queryString) {
          // Advanced search - use stored query string, update mode
          const params = new URLSearchParams(this.queryString);
          params.set('mode', this.mode);
          url += '?' + params.toString();
        } else if (input.value) {
          // Basic search - use input value
          url += '?q=' + encodeURIComponent(input.value) + '&mode=' + this.mode;
        } else {
          return; // No search to cycle
        }

        htmx.ajax('GET', url, '#search-results');
      },

      clearAdvancedState() {
        // Clear stored query string when doing a new basic search via form
        // This ensures cycleMode uses the input value, not stale advanced params
        this.queryString = '';
        this.mode = 'kanji';
        this.currentGroup = 0;
      },

      currentGroup: 0,

      _updateScrollThumb() {
        var scroller = this.$refs.resultsContainer?.querySelector('.scroller');
        var thumb = this.$refs.scrollThumb;
        if (!scroller || !thumb) return;
        var sw = scroller.scrollWidth;
        var ow = scroller.offsetWidth;
        if (sw <= ow) { thumb.style.display = 'none'; return; }
        thumb.style.display = '';
        var thumbW = Math.max(30, (ow / sw) * ow);
        var maxSL = sw - ow;
        var sRatio = maxSL > 0 ? scroller.scrollLeft / maxSL : 0;
        thumb.style.width = thumbW + 'px';
        thumb.style.left = (sRatio * (ow - thumbW)) + 'px';
      },

      _smoothScroll(el, target) {
        if (_animFrame) {
          cancelAnimationFrame(_animFrame);
          _animFrame = null;
        }

        var start = el.scrollLeft;
        var change = Math.round(target - start);
        if (!change) return;
        var startTime = performance.now();
        var saved = el.style.scrollBehavior;
        el.style.scrollBehavior = 'auto';

        function ease(t) {
          return t < 0.5 ? 2 * t * t : 1 - 2 * (1 - t) * (1 - t);
        }

        function step(now) {
          var t = Math.min((now - startTime) / 900, 1);
          el.scrollLeft = start + Math.ceil(change * ease(t));
          if (t < 1) {
            _animFrame = requestAnimationFrame(step);
          } else {
            el.style.scrollBehavior = saved;
            _animFrame = null;
          }
        }

        _animFrame = requestAnimationFrame(step);
      },

      scrollForward() {
        var scroller = this.$refs.resultsContainer?.querySelector('.scroller');
        if (!scroller) return;

        if (this.mode === 'kanji') {
          this._smoothScroll(scroller, scroller.scrollLeft + scroller.offsetWidth);
        } else {
          var groups = scroller.querySelectorAll('.results-group');
          if (groups.length === 0) return;
          this.currentGroup = Math.min(groups.length - 1, this.currentGroup + 1);
          this._smoothScroll(scroller, Math.max(0, groups[this.currentGroup].offsetLeft));
        }
      },

      scrollBackward() {
        var scroller = this.$refs.resultsContainer?.querySelector('.scroller');
        if (!scroller) return;

        if (this.mode === 'kanji') {
          this._smoothScroll(scroller, Math.max(0, scroller.scrollLeft - scroller.offsetWidth));
        } else {
          var groups = scroller.querySelectorAll('.results-group');
          if (groups.length === 0) return;
          this.currentGroup = Math.max(0, this.currentGroup - 1);
          this._smoothScroll(scroller, Math.max(0, groups[this.currentGroup].offsetLeft));
        }
      },

      handleWheel(event) {
        var scroller = this.$refs.resultsContainer?.querySelector('.scroller');
        if (!scroller) return;
        if (Math.abs(event.deltaY) > Math.abs(event.deltaX)) {
          event.preventDefault();
          scroller.scrollLeft += event.deltaY;
        }
      },

      startThumbDrag(event) {
        event.preventDefault();
        var scroller = this.$refs.resultsContainer?.querySelector('.scroller');
        var thumb = this.$refs.scrollThumb;
        var track = this.$refs.scrollTrack;
        if (!scroller || !thumb) return;
        var startX = event.clientX;
        var startScrollLeft = scroller.scrollLeft;
        var maxThumbTravel = scroller.offsetWidth - thumb.offsetWidth;
        var maxScroll = scroller.scrollWidth - scroller.offsetWidth;
        if (maxThumbTravel <= 0 || maxScroll <= 0) return;
        // Imperative class toggle keeps the bar visible while the cursor is
        // outside the wrapper mid-drag (CSS :hover alone would fade it)
        if (track) track.classList.add('sb-dragging');
        var onMove = function (ev) {
          scroller.scrollLeft = startScrollLeft + (ev.clientX - startX) * (maxScroll / maxThumbTravel);
        };
        var onUp = function () {
          document.removeEventListener('mousemove', onMove);
          document.removeEventListener('mouseup', onUp);
          if (track) track.classList.remove('sb-dragging');
        };
        document.addEventListener('mousemove', onMove);
        document.addEventListener('mouseup', onUp);
      },

      init() {
        // Read page-specific state from data-* attributes
        this.mode = this.$el.dataset.mode || 'kanji';
        this.queryString = this.$el.dataset.querystring || '';

        var self = this;

        // Update custom scrollbar on scroll (capture phase catches child .scroller)
        this._scrollHandler = function() { self._updateScrollThumb(); };
        this.$refs.resultsContainer.addEventListener('scroll', this._scrollHandler, true);

        // Update after HTMX swaps new results
        this._settleHandler = function() { self._updateScrollThumb(); };
        document.addEventListener('htmx:afterSettle', this._settleHandler);

        // Initial update
        this._updateScrollThumb();

        // Keyboard shortcuts for arrow keys
        this._keyHandler = (e) => {
          if (e.target.tagName === 'INPUT') return;

          switch(e.code) {
            case 'ArrowUp':
              e.preventDefault();
              this.cycleMode(-1);
              break;
            case 'ArrowDown':
              e.preventDefault();
              this.cycleMode(1);
              break;
            case 'ArrowLeft':
              this.scrollBackward();
              break;
            case 'ArrowRight':
              this.scrollForward();
              break;
          }
        };
        document.addEventListener('keydown', this._keyHandler);
      },

      destroy() {
        if (this._settleHandler) {
          document.removeEventListener('htmx:afterSettle', this._settleHandler);
        }
        if (this._keyHandler) {
          document.removeEventListener('keydown', this._keyHandler);
        }
        if (this._scrollHandler && this.$refs.resultsContainer) {
          this.$refs.resultsContainer.removeEventListener('scroll', this._scrollHandler, true);
        }
      }
    };
    });
  });
  </script>

  <base href="/">
</head>
<body>

<div class="container">
<div class="container2" x-data="searchPage()" data-mode="<%= typeof mode !== 'undefined' ? mode : 'kanji' %>" data-querystring="<%= typeof queryString !== 'undefined' ? queryString.replace(/"/g, '&quot;') : '' %>">

  <!-- Header Row -->
  <header class="header-row">
    <!-- Search Form -->
    <div class="col1">
      <div class="row1">
        <form class="search-form"
              hx-get="/htmx/partials/results"
              hx-target="#search-results"
              hx-trigger="submit"
              @submit.prevent="clearAdvancedState()">
          <input type="text"
                 name="q"
                 id="search-input"
                 class="search-bar"
                 value="<%= typeof query !== 'undefined' ? query : '' %>"
                 spellcheck="false"
                 autocapitalize="off"
                 autocorrect="off"
                 @keydown.up.prevent="cycleMode(-1)"
                 @keydown.down.prevent="cycleMode(1)">
          <button type="submit" class="search-button" aria-label="Search"></button>
        </form>
      </div>
    </div>

    <!-- Sort Controls -->
    <div class="col2">
      <div class="row1">
        <div class="recordCounter">
          <button class="icon icon-left"
                  @click="scrollBackward()"
                  aria-label="Scroll left">&#12296;</button>
          <span class="search">
            <button @click="cycleMode(1)" class="sort-button">Sort</button>
          </span>
          <button class="icon icon-right"
                  @click="scrollForward()"
                  aria-label="Scroll right">&#12297;</button>
        </div>
      </div>
    </div>

    <!-- Info Button -->
    <div class="col3">
      <div class="row1">
        <button class="info-button" @click="$refs.helpDialog.showModal()">
          <span>Info</span>
        </button>
      </div>
    </div>

    <!-- Branding -->
    <div class="col4">
      <div class="row1 desktop-branding">
        <a href="https://kanjialive.com" target="_blank" rel="noopener">
          <span class="ka-welcome-italic">Kanji alive</span>
        </a>
      </div>
    </div>
  </header>

  <!-- Decorative Borders -->
  <div class="border1"><div class="border-inner"></div></div>
  <div class="border2"><div class="border-inner"></div></div>

  <!-- Results Container -->
  <main id="search-results"
        class="row3 scrollbar-wrapper"
        x-ref="resultsContainer"
        @wheel="handleWheel($event)">
    <% if (typeof results !== 'undefined' && results.length > 0) { %>
      <%- include('../partials/results', { results, mode, kanjiStrokeGroups, radicalStrokeGroups, query, resultsOrder }) %>
    <% } else if (typeof query !== 'undefined' && query) { %>
      <%- include('../partials/no-results') %>
    <% } else { %>
      <%- include('../partials/welcome') %>
    <% } %>
    <div class="custom-scrollbar-track" x-ref="scrollTrack">
      <div class="custom-scrollbar-thumb" x-ref="scrollThumb" @mousedown="startThumbDrag($event)"></div>
    </div>
  </main>

  <!-- Help Modal -->
  <dialog x-ref="helpDialog" class="help-modal" @click.self="$refs.helpDialog.close()">
    <%- include('../partials/search-help-modal') %>
  </dialog>

  <!-- Version -->
  <div class="version"><p>v3.00</p></div>
</div>

<!-- Logo -->
<div class="logo">
  <img src="https://media.kanjialive.com/img/fan_logo_104.jpg" alt="Kanji alive logo" loading="lazy"/>
</div>
</div>


</body>
</html>
